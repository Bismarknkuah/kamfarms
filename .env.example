# --- Database ---------------------------------------------------------
DATABASE_URL=postgresql://kam:kam_dev_password@localhost:5432/kam_roms?schema=public

# --- Auth ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Frontend -> Backend ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
WEB_ORIGIN=http://localhost:3000

# --- Object storage (MinIO in dev; S3-compatible in prod) -----------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=kam_minio
STORAGE_SECRET_KEY=kam_minio_password
STORAGE_BUCKET=kam-roms-documents

# --- Email (real SMTP delivery - password reset, etc.) --------------------
# For Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=your
# sending address, EMAIL_PASSWORD=a Gmail App Password (not your regular
# password - generate one at https://myaccount.google.com/apppasswords,
# requires 2-Step Verification enabled on the account first). Leaving
# EMAIL_HOST blank is safe - the app falls back to logging the reset link
# instead of sending it, rather than failing.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# --- AI service (Phase 11) -------------------------------------------------
AI_SERVICE_URL=http://localhost:8000

PORT=4000
