// KAM-ROMS — Prisma schema
// Conventions: UUID PKs, created_at/updated_at on every table, Decimal for
// money/KG, append-only inventory_transactions, soft delete only where it
// does not destroy financial/inventory history (see comments per model).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum ScopeType {
  GLOBAL
  FARM
  WAREHOUSE
  MILLING_CENTER
  DEPARTMENT
}

enum RoleCode {
  ADMIN
  MD
  FARM_DIRECTOR
  FARM_MANAGER
  WAREHOUSE_SUPERVISOR
  WAREHOUSE_MANAGER
  OPERATIONS_MANAGER
  OPERATIONS_OFFICER
  SALES_OFFICER
  FINANCE_DIRECTOR
  FINANCE_OFFICER
  AUDITOR
  CUSTOM
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
  PENDING_VERIFICATION
}

enum PaddyEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DeliveryStatus {
  DRAFT
  SUBMITTED
  SUPERVISOR_REVIEW
  APPROVED
  REJECTED
  IN_TRANSIT
  ARRIVED
  RECONCILED
  CANCELLED
}

enum InventoryTxnType {
  PADDY_RECEIVED
  PADDY_APPROVED
  PADDY_RESERVED
  PADDY_DISPATCHED
  PADDY_IN_TRANSIT
  PADDY_RECEIVED_AT_WAREHOUSE
  PADDY_SENT_TO_MILL
  PADDY_RECEIVED_AT_MILL
  PADDY_PROCESSED
  RICE_RECOVERED
  BROKEN_RICE_GENERATED
  RICE_HULL_GENERATED
  PACKAGED_RICE_CREATED
  PACKAGED_RICE_DISPATCHED
  PACKAGED_RICE_SOLD
  PACKAGED_RICE_RETURNED
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  STOCK_LOSS
  STOCK_CORRECTION
}

enum InventoryState {
  AVAILABLE
  RESERVED
  IN_TRANSIT
  RECEIVED
  PROCESSED
  SOLD
  DAMAGED
  LOST
  ADJUSTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MachineStatus {
  RUNNING
  IDLE
  MAINTENANCE
  FAULT
  OFFLINE
}

enum QualityStatus {
  PENDING
  PASSED
  FAILED
  QUARANTINED
  RELEASED
}

enum SalesOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  RESERVED
  FULFILLED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  BANK_DEPOSIT
  CASH
  OTHER_APPROVED_METHOD
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REFUNDED
  PARTIALLY_APPLIED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  SUBMITTED
  REVIEW
  COMPLETED
  REJECTED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum ResetType {
  CLEAR_TEST_DATA
  RESET_INVENTORY
  RESET_TRANSACTIONS
  RESET_MODULE
  RESET_DATE_RANGE
  FULL_OPERATIONAL_RESET
  OTHER
}

enum ResetStatus {
  REQUESTED
  FINANCE_APPROVED
  MD_APPROVED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}

// ============================================================
// ORG / AUTH  (Phase 1 — fully implemented this delivery)
// ============================================================

enum LocationType {
  FARM
  WAREHOUSE
  MILLING_CENTER
  CUSTOMER
  EXTERNAL
}

enum DeliveryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeliveryOrderStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum Shift {
  DAY
  NIGHT
}

enum ProductionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum MaintenanceType {
  SCHEDULED
  BREAKDOWN
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum ConversationType {
  DIRECT
  GROUP
  DEPARTMENT
  ROLE
  WAREHOUSE
  FARM
  BROADCAST
  ANNOUNCEMENT
}

enum MessageReceiptStatus {
  SENT
  DELIVERED
  READ
  ACKNOWLEDGED
  RESPONDED
}

model Company {
  id            String   @id @default(uuid())
  name          String
  poBox         String?
  address       String?
  email         String?
  phone1        String?
  phone2        String?
  facebook      String?
  currency      String   @default("GHS")
  timezone      String   @default("Africa/Accra")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  facilities    Facility[]
  settings      SystemSetting[]

  @@map("companies")
}

model Facility {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  type        String // e.g. MANUFACTURING, HQ
  region      String?
  townOrArea  String?
  gpsAddress  String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("facilities")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@map("departments")
}

model User {
  id                  String        @id @default(uuid())
  employeeNumber      String?       @unique @map("employee_number")
  firstName           String        @map("first_name")
  lastName            String        @map("last_name")
  email               String        @unique
  phone               String?
  passwordHash        String        @map("password_hash")
  status              UserStatus    @default(ACTIVE)
  mustChangePassword  Boolean       @default(false) @map("must_change_password")
  mfaEnabled          Boolean       @default(false) @map("mfa_enabled")
  mfaSecret           String?       @map("mfa_secret")
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  departmentId        String?       @map("department_id")
  department          Department?   @relation(fields: [departmentId], references: [id])
  failedLoginCount    Int           @default(0) @map("failed_login_count")
  lockedUntil         DateTime?     @map("locked_until")
  lastLoginAt         DateTime?     @map("last_login_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at") // soft delete OK: no financial/inventory history on User itself

  roles               UserRole[]
  refreshTokens       RefreshToken[]
  loginAttempts       LoginAttempt[]
  auditLogs           AuditLog[]        @relation("AuditActor")
  farmManagerOf       FarmManager[]
  warehouseManagerOf  WarehouseManager[]
  paddyEntriesSubmitted PaddyEntry[]    @relation("PaddySubmittedBy")
  paddyEntriesApproved  PaddyEntry[]    @relation("PaddyApprovedBy")
  inventoryTransactions InventoryTransaction[]
  deliveryOrdersCreated   DeliveryOrder[]
  deliveryReportsSubmitted DeliveryReport[] @relation("DeliverySubmittedBy")
  deliveryReportsApproved  DeliveryReport[] @relation("DeliveryApprovedBy")
  shipmentsReceived        Shipment[]
  machineMaintenanceLogs   MachineMaintenance[]
  meterReadings            MeterReading[]
  productionRecordsOperated ProductionRecord[] @relation("ProductionOperator")
  productionRecordsSubmitted ProductionRecord[] @relation("ProductionSubmittedBy")
  productionRecordsApproved  ProductionRecord[] @relation("ProductionApprovedBy")
  qualityInspections         QualityInspection[]
  packagingBatches           PackagingBatch[]
  productPricesCreated       ProductPrice[]
  salesOrdersAsOfficer       SalesOrder[] @relation("SalesOfficer")
  salesOrdersSubmitted       SalesOrder[] @relation("SalesOrderSubmittedBy")
  salesOrdersApproved        SalesOrder[] @relation("SalesOrderApprovedBy")
  invoicesCreated            Invoice[]
  paymentsRecorded           Payment[]    @relation("PaymentRecordedBy")
  paymentsVerified           Payment[]    @relation("PaymentVerifiedBy")
  expensesSubmitted          Expense[]    @relation("ExpenseSubmittedBy")
  expensesApproved           Expense[]    @relation("ExpenseApprovedBy")
  conversationsCreated       Conversation[] @relation("ConversationCreatedBy")
  conversationMemberships    ConversationMember[]
  messagesSent               Message[]
  messageReceipts            MessageReceipt[]
  notifications               Notification[]
  tasksAssigned               Task[]        @relation("TaskAssignedTo")
  tasksCreated                Task[]        @relation("TaskCreatedBy")
  tasksCompleted              Task[]        @relation("TaskCompletedBy")
  taskComments                TaskComment[]
  aiPredictionsRequested      AiPrediction[]
  backupRecordsTriggered      BackupRecord[]
  resetRequestsCreated        ResetRequest[] @relation("ResetRequestedBy")
  resetRequestsFinanceApproved ResetRequest[] @relation("ResetFinanceApprovedBy")
  resetRequestsMdApproved     ResetRequest[] @relation("ResetMdApprovedBy")
  stockTransfersRequested     StockTransfer[] @relation("StockTransferRequestedBy")
  stockTransfersReceived      StockTransfer[] @relation("StockTransferReceivedBy")
  inventoryAdjustmentsRequested InventoryAdjustment[] @relation("InventoryAdjustmentRequestedBy")
  inventoryAdjustmentsApproved  InventoryAdjustment[] @relation("InventoryAdjustmentApprovedBy")
  resetRequestsRejected       ResetRequest[] @relation("ResetRejectedBy")
  resetRequestsExecuted       ResetRequest[] @relation("ResetExecutedBy")

  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. FARM_MANAGER, or CUSTOM_xxx for cloned roles
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role") // built-in roles cannot be deleted
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permissions  RolePermission[]
  userRoles    UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. paddy.approve
  module      String   // e.g. paddy
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A user may hold multiple roles; each grant may carry its own scope(s).
model UserRole {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  roleId    String     @map("role_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id])
  grantedBy String?    @map("granted_by")
  createdAt DateTime   @default(now()) @map("created_at")
  scopes    UserScope[]

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model UserScope {
  id         String    @id @default(uuid())
  userRoleId String    @map("user_role_id")
  userRole   UserRole  @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  scopeType  ScopeType @map("scope_type")
  scopeId    String?   @map("scope_id") // null when scopeType = GLOBAL
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userRoleId])
  @@index([scopeType, scopeId])
  @@map("user_scopes")
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique @map("token_hash")
  deviceLabel   String?   @map("device_label")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedByHash String?  @map("replaced_by_hash")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  email      String
  success    Boolean
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("login_attempts")
}

// ============================================================
// FARMS (Phase 2/3 models — scaffolded now, wired later)
// ============================================================

model Farm {
  id        String   @id @default(uuid())
  code      String   @unique // FARM_A ...
  name      String
  location  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  managers      FarmManager[]
  paddyEntries  PaddyEntry[]
  paddyBatches  PaddyBatch[]
  deliveryOrders  DeliveryOrder[]
  deliveryReports DeliveryReport[]
  shipments       Shipment[]
  expenses        Expense[]
  tasks           Task[]

  @@map("farms")
}

model FarmManager {
  id        String   @id @default(uuid())
  farmId    String   @map("farm_id")
  userId    String   @map("user_id")
  farm      Farm     @relation(fields: [farmId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([farmId, userId])
  @@map("farm_managers")
}

model PaddyType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  paddyEntries PaddyEntry[]

  @@map("paddy_types")
}

// Configurable — Admin defines grades (e.g. "Size 4", "Size 5") without code changes
model PaddyGrade {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. SIZE_4
  label       String   // e.g. "Size 4"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  paddyEntries          PaddyEntry[]
  paddyBatches          PaddyBatch[]
  inventoryTransactions InventoryTransaction[]
  inventoryBalances     InventoryBalance[]
  deliveryOrders        DeliveryOrder[]
  deliveryReports       DeliveryReport[]
  shipments             Shipment[]
  productionRecords     ProductionRecord[]
  inventoryAdjustments  InventoryAdjustment[]

  @@map("paddy_grades")
}

// ============================================================
// WAREHOUSES / MILLING (scaffolded)
// ============================================================

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  location  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  managers        WarehouseManager[]
  millingCenters  MillingCenter[]
  deliveryOrders  DeliveryOrder[]
  deliveryReports DeliveryReport[]
  shipments       Shipment[]
  packagingBatches PackagingBatch[]
  salesOrdersPreferred SalesOrder[] @relation("PreferredWarehouse")
  salesOrdersAllocated SalesOrder[] @relation("AllocatedWarehouse")
  stockReservations    StockReservation[]
  expenses             Expense[]
  tasks                Task[]
  transfersOut         StockTransfer[] @relation("TransferSource")
  transfersIn          StockTransfer[] @relation("TransferDest")

  @@map("warehouses")
}

model WarehouseManager {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  userId      String    @map("user_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([warehouseId, userId])
  @@map("warehouse_managers")
}

model MillingCenter {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String    @unique
  name        String
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  machines         Machine[]
  productionRecords ProductionRecord[]
  packagingBatches  PackagingBatch[]

  @@map("milling_centers")
}

// ============================================================
// PRODUCTS / PACKAGING (scaffolded — configurable, no hard-coded sizes)
// ============================================================

model Product {
  id          String   @id @default(uuid())
  name        String   // e.g. "Pectra Rice"
  description String?  // e.g. "Superfine Perfumed Rice"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  inventoryTransactions InventoryTransaction[]
  inventoryBalances     InventoryBalance[]
  packagingBatches      PackagingBatch[]
  prices                ProductPrice[]
  salesOrderItems       SalesOrderItem[]
  stockReservations     StockReservation[]
  invoiceItems          InvoiceItem[]
  stockTransfers        StockTransfer[]
  inventoryAdjustments  InventoryAdjustment[]

  @@map("products")
}

model PackagingSize {
  id           String   @id @default(uuid())
  label        String   @unique // "1KG", "5KG" ...
  sizeKg       Decimal  @map("size_kg") @db.Decimal(10, 3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  inventoryTransactions InventoryTransaction[]
  inventoryBalances     InventoryBalance[]
  packagingBatches      PackagingBatch[]
  prices                ProductPrice[]
  salesOrderItems       SalesOrderItem[]
  stockReservations     StockReservation[]
  invoiceItems          InvoiceItem[]
  stockTransfers        StockTransfer[]
  inventoryAdjustments  InventoryAdjustment[]

  @@map("packaging_sizes")
}

// ============================================================
// SYSTEM SETTINGS / AUDIT (Phase 1 partial — audit fully wired)
// ============================================================

model SystemSetting {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Append-only. No update/delete performed by application code.
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  user         User?    @relation("AuditActor", fields: [userId], references: [id])
  roleSnapshot String?  @map("role_snapshot")
  action       String   // e.g. "user.create", "paddy.approve"
  entity       String   // e.g. "User", "PaddyEntry"
  entityId     String?  @map("entity_id")
  beforeValue  Json?    @map("before_value")
  afterValue   Json?    @map("after_value")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// INVENTORY LEDGER CORE (Phase 3 — fully implemented this delivery)
//
// inventory_transactions is APPEND-ONLY: application code only ever
// inserts rows, never updates/deletes them (a DB trigger enforcing this
// is planned for the Phase 13 hardening pass; until then it is enforced
// by convention — no service method in this codebase exposes an update
// or delete on this table). Corrections are new reversal transactions.
//
// inventory_balances is a materialized read-model, recomputed inside the
// same DB transaction as the ledger insert that changed it — never a
// value trusted as authoritative on its own; it exists purely so reads
// don't have to SUM() the full ledger every time.
// ============================================================

model InventoryTransaction {
  id                String           @id @default(uuid())
  transactionNumber String           @unique @map("transaction_number") // e.g. TXN-2026-000123
  type              InventoryTxnType
  sourceLocationType LocationType?   @map("source_location_type")
  sourceLocationId  String?          @map("source_location_id")
  destLocationType  LocationType?    @map("dest_location_type")
  destLocationId    String?          @map("dest_location_id")
  paddyGradeId      String?          @map("paddy_grade_id")
  paddyGrade        PaddyGrade?      @relation(fields: [paddyGradeId], references: [id])
  productId         String?          @map("product_id")
  product           Product?         @relation(fields: [productId], references: [id])
  packagingSizeId   String?          @map("packaging_size_id")
  packagingSize     PackagingSize?   @relation(fields: [packagingSizeId], references: [id])
  quantityKg        Decimal          @map("quantity_kg") @db.Decimal(14, 3)
  bagCount          Int?             @map("bag_count")
  batchNumber       String?          @map("batch_number")
  referenceDocument String?          @map("reference_document") // e.g. paddy entry number, delivery order number
  userId            String           @map("user_id")
  user              User             @relation(fields: [userId], references: [id])
  reason            String?
  approvalStatus    ApprovalStatus   @default(APPROVED) @map("approval_status")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([type])
  @@index([sourceLocationType, sourceLocationId])
  @@index([destLocationType, destLocationId])
  @@index([batchNumber])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// One row per (location, material). Quantities are always >= 0 — negative
// inventory is rejected at the service layer (spec rule 1), never at the
// DB alone, so a clear error message reaches the caller.
model InventoryBalance {
  id              String         @id @default(uuid())
  locationType    LocationType   @map("location_type")
  locationId      String         @map("location_id")
  paddyGradeId    String?        @map("paddy_grade_id")
  paddyGrade      PaddyGrade?    @relation(fields: [paddyGradeId], references: [id])
  productId       String?        @map("product_id")
  product         Product?       @relation(fields: [productId], references: [id])
  packagingSizeId String?        @map("packaging_size_id")
  packagingSize   PackagingSize? @relation(fields: [packagingSizeId], references: [id])
  // Non-nullable, deterministically derived from paddyGradeId/productId/
  // packagingSizeId (see InventoryLedgerService.buildDimensionKey). Exists
  // ONLY so the compound unique constraint below — and therefore
  // findUnique/upsert — has something to key on. Postgres treats every
  // NULL as distinct from every other NULL, so a unique constraint or a
  // findUnique lookup spanning nullable columns can never reliably target
  // one row; the three FK columns above stay nullable for normal
  // filtering/joins, this column exists purely to make uniqueness and
  // point-lookups well-defined.
  dimensionKey    String         @map("dimension_key")
  quantityKg      Decimal        @default(0) @map("quantity_kg") @db.Decimal(14, 3)
  bagCount        Int            @default(0) @map("bag_count")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([locationType, locationId, dimensionKey], name: "balance_key")
  @@index([locationType, locationId])
  @@map("inventory_balances")
}

// Section 24's exact requirement: nobody types "warehouse stock =
// 5,000 bags." A correction is its own real, approved, permanent
// transaction — the original balance-affecting history it corrects
// stays completely untouched. Mirrors InventoryBalance's own flexible
// dimension shape (exactly one of paddyGrade or product+packagingSize
// set, matching whatever's actually being corrected) rather than
// inventing a different convention for the same three location types.
model InventoryAdjustment {
  id               String              @id @default(uuid())
  adjustmentNumber String              @unique @map("adjustment_number") // ADJ-2026-000123
  locationType     LocationType        @map("location_type")
  locationId       String              @map("location_id")
  paddyGradeId     String?             @map("paddy_grade_id")
  paddyGrade       PaddyGrade?         @relation(fields: [paddyGradeId], references: [id])
  productId        String?            @map("product_id")
  product          Product?            @relation(fields: [productId], references: [id])
  packagingSizeId  String?             @map("packaging_size_id")
  packagingSize    PackagingSize?      @relation(fields: [packagingSizeId], references: [id])

  // Snapshot of what the ledger showed at request time — for the
  // approver's context, not itself the source of truth (the actual
  // balance may have moved between request and approval; the approval
  // step re-checks against the live balance, not this snapshot).
  systemQuantityKg  Decimal @map("system_quantity_kg") @db.Decimal(14, 3)
  systemBagCount    Int     @map("system_bag_count")
  adjustmentKg      Decimal @map("adjustment_kg") @db.Decimal(14, 3) // signed: negative = shortage, positive = found stock
  adjustmentBags    Int     @map("adjustment_bags")
  reason            String

  status         ApprovalStatus @default(PENDING)
  requestedById  String         @map("requested_by_id")
  requestedBy    User           @relation("InventoryAdjustmentRequestedBy", fields: [requestedById], references: [id])
  requestedAt    DateTime       @default(now()) @map("requested_at")
  approvedById   String?        @map("approved_by_id")
  approvedBy     User?          @relation("InventoryAdjustmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?      @map("approved_at")
  rejectionReason String?       @map("rejection_reason")

  @@index([locationType, locationId])
  @@map("inventory_adjustments")
}

// ============================================================
// PADDY / FARM INVENTORY WORKFLOW (Phase 3)
// ============================================================

model PaddyEntry {
  id               String           @id @default(uuid())
  entryNumber      String           @unique @map("entry_number") // e.g. PE-2026-000123
  farmId           String           @map("farm_id")
  farm             Farm             @relation(fields: [farmId], references: [id])
  entryDate        DateTime         @map("entry_date")
  paddyTypeId      String?          @map("paddy_type_id")
  paddyType        PaddyType?       @relation(fields: [paddyTypeId], references: [id])
  paddyGradeId     String           @map("paddy_grade_id")
  paddyGrade       PaddyGrade       @relation(fields: [paddyGradeId], references: [id])
  weightKg         Decimal          @map("weight_kg") @db.Decimal(12, 3)
  bagCount         Int              @map("bag_count")
  avgBagWeightKg   Decimal          @map("avg_bag_weight_kg") @db.Decimal(8, 3)
  // Most farms don't have a scale on-site. When weight isn't measured,
  // it's estimated from bag count using a standard bag weight so the
  // inventory ledger, mass-balance checks, and recovery-rate math
  // downstream still have a real KG figure to work with — this flag is
  // what keeps that estimate honest instead of silently indistinguishable
  // from an actual measurement.
  weightEstimated  Boolean          @default(false) @map("weight_estimated")
  moisturePercent  Decimal?         @map("moisture_percent") @db.Decimal(5, 2)
  qualityGrade     String?          @map("quality_grade")
  harvestDate      DateTime?        @map("harvest_date")
  supplierName     String?          @map("supplier_name")
  storageLocation  String?          @map("storage_location")
  notes            String?
  batchNumber      String           @unique @map("batch_number") // e.g. PB-2026-000123, assigned at creation for traceability even in DRAFT
  status           PaddyEntryStatus @default(DRAFT)
  rejectionReason  String?          @map("rejection_reason")
  submittedById    String           @map("submitted_by_id")
  submittedBy      User             @relation("PaddySubmittedBy", fields: [submittedById], references: [id])
  submittedAt      DateTime?        @map("submitted_at")
  approvedById     String?          @map("approved_by_id")
  approvedBy       User?            @relation("PaddyApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?        @map("approved_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  batch            PaddyBatch?

  @@index([farmId])
  @@index([status])
  @@index([entryDate])
  @@map("paddy_entries")
}

// Created only once a PaddyEntry is APPROVED — this is the traceable,
// immutable "official" batch record referenced by every downstream
// inventory transaction and, from Phase 4+, deliveries/milling/packaging.
model PaddyBatch {
  id             String     @id @default(uuid())
  batchNumber    String     @unique @map("batch_number")
  paddyEntryId   String     @unique @map("paddy_entry_id")
  paddyEntry     PaddyEntry @relation(fields: [paddyEntryId], references: [id])
  farmId         String     @map("farm_id")
  farm           Farm       @relation(fields: [farmId], references: [id])
  paddyGradeId   String     @map("paddy_grade_id")
  paddyGrade     PaddyGrade @relation(fields: [paddyGradeId], references: [id])
  totalKg        Decimal    @map("total_kg") @db.Decimal(12, 3)
  bagCount       Int        @map("bag_count")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("paddy_batches")
}

// ============================================================
// DELIVERY / IN-TRANSIT / WAREHOUSE RECEIVING (Phase 4)
//
// In-transit stock is modeled as a real location: LocationType.EXTERNAL
// with locationId = the Shipment's own id. This is what makes rule 7 ("in-
// transit stock is not available stock") automatically true — while a
// shipment is in transit, its KG live in a balance bucket that no farm or
// warehouse query ever looks at. On receipt, the bucket is closed out.
// ============================================================

model Vehicle {
  id           String   @id @default(uuid())
  plateNumber  String   @unique @map("plate_number")
  vehicleType  String?  @map("vehicle_type")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  deliveryReports DeliveryReport[]

  @@map("vehicles")
}

model Driver {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  licenseNumber  String?  @unique @map("license_number")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  deliveryReports DeliveryReport[]

  @@map("drivers")
}

model DeliveryOrder {
  id                     String              @id @default(uuid())
  orderNumber            String              @unique @map("order_number") // DO-2026-000123
  farmId                 String              @map("farm_id")
  farm                   Farm                @relation(fields: [farmId], references: [id])
  destinationWarehouseId String              @map("destination_warehouse_id")
  destinationWarehouse   Warehouse           @relation(fields: [destinationWarehouseId], references: [id])
  requestedDate          DateTime            @map("requested_date")
  paddyGradeId           String              @map("paddy_grade_id")
  paddyGrade             PaddyGrade          @relation(fields: [paddyGradeId], references: [id])
  bagCount               Int                 @map("bag_count")
  totalKg                Decimal             @map("total_kg") @db.Decimal(12, 3)
  priority               DeliveryPriority    @default(NORMAL)
  notes                  String?
  status                 DeliveryOrderStatus @default(PENDING)
  createdById            String              @map("created_by_id")
  createdBy              User                @relation(fields: [createdById], references: [id])
  createdAt              DateTime            @default(now()) @map("created_at")

  reports DeliveryReport[]

  @@index([farmId])
  @@index([destinationWarehouseId])
  @@map("delivery_orders")
}

model DeliveryReport {
  id                     String         @id @default(uuid())
  reportNumber           String         @unique @map("report_number") // DR-2026-000123
  deliveryOrderId        String         @map("delivery_order_id")
  deliveryOrder          DeliveryOrder  @relation(fields: [deliveryOrderId], references: [id])
  farmId                 String         @map("farm_id")
  farm                   Farm           @relation(fields: [farmId], references: [id])
  destinationWarehouseId String         @map("destination_warehouse_id")
  destinationWarehouse   Warehouse      @relation(fields: [destinationWarehouseId], references: [id])
  paddyGradeId           String         @map("paddy_grade_id")
  paddyGrade             PaddyGrade     @relation(fields: [paddyGradeId], references: [id])

  actualBagCount   Int      @map("actual_bag_count")
  actualKg         Decimal  @map("actual_kg") @db.Decimal(12, 3)

  labourCost        Decimal @default(0) @map("labour_cost") @db.Decimal(12, 2)
  numberOfLabourers Int?    @map("number_of_labourers")
  costPerLabourer   Decimal? @map("cost_per_labourer") @db.Decimal(10, 2)
  transportationFee Decimal @default(0) @map("transportation_fee") @db.Decimal(12, 2)
  otherCosts        Decimal @default(0) @map("other_costs") @db.Decimal(12, 2)
  otherCostsDescription String? @map("other_costs_description")
  totalDeliveryCost Decimal @map("total_delivery_cost") @db.Decimal(12, 2) // labour + transport + other, computed server-side

  vehicleId             String?   @map("vehicle_id")
  vehicle               Vehicle?  @relation(fields: [vehicleId], references: [id])
  driverId               String?  @map("driver_id")
  driver                 Driver?  @relation(fields: [driverId], references: [id])
  departureDate          DateTime? @map("departure_date")
  departureTime          String?   @map("departure_time")
  expectedArrivalTime    String?   @map("expected_arrival_time")
  loadingLocation        String?   @map("loading_location")
  destinationLocationText String? @map("destination_location_text")
  remarks                String?

  status            DeliveryStatus @default(DRAFT)
  rejectionReason   String?        @map("rejection_reason")
  submittedById     String         @map("submitted_by_id")
  submittedBy       User           @relation("DeliverySubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime?      @map("submitted_at")
  approvedById      String?        @map("approved_by_id")
  approvedBy        User?          @relation("DeliveryApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?      @map("approved_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  shipment Shipment?

  @@index([farmId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("delivery_reports")
}

model Shipment {
  id               String    @id @default(uuid())
  shipmentNumber   String    @unique @map("shipment_number") // SH-2026-000123
  deliveryReportId String    @unique @map("delivery_report_id")
  deliveryReport   DeliveryReport @relation(fields: [deliveryReportId], references: [id])
  farmId           String    @map("farm_id")
  farm             Farm      @relation(fields: [farmId], references: [id])
  warehouseId      String    @map("warehouse_id")
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  paddyGradeId     String    @map("paddy_grade_id")
  paddyGrade       PaddyGrade @relation(fields: [paddyGradeId], references: [id])

  expectedKg    Decimal   @map("expected_kg") @db.Decimal(12, 3)
  expectedBags  Int       @map("expected_bags")
  receivedKg    Decimal?  @map("received_kg") @db.Decimal(12, 3)
  receivedBags  Int?      @map("received_bags")
  varianceKg    Decimal?  @map("variance_kg") @db.Decimal(12, 3)
  varianceRequiresApproval Boolean @default(false) @map("variance_requires_approval")
  // Section 7's exact requirement: receiving must capture condition and
  // moisture at the point of arrival, not just quantity — this can
  // genuinely differ from what was recorded at the farm if the load sat
  // in transit (rain, humidity, rough handling). Vehicle and driver are
  // already captured on the linked DeliveryReport and don't need
  // duplicating here.
  receivedCondition        String?  @map("received_condition")
  receivedMoisturePercent  Decimal? @map("received_moisture_percent") @db.Decimal(5, 2)

  departedAt   DateTime  @default(now()) @map("departed_at")
  receivedAt   DateTime? @map("received_at")
  receivedById String?   @map("received_by_id")
  receivedBy   User?     @relation(fields: [receivedById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")

  events ShipmentEvent[]

  @@index([farmId])
  @@index([warehouseId])
  @@map("shipments")
}

// Section 23's exact requirement: a transfer between warehouses is
// never just a number changing in two places, and it's never a single
// step either — dispatch and receipt are genuinely separate events with
// their own timestamps and their own possible variance, the same
// two-step shape Shipment already uses for farm-to-warehouse paddy
// movement. Stock genuinely passes through EXTERNAL (the same in-
// transit pseudo-location paddy already uses) between the two.
model StockTransfer {
  id                String              @id @default(uuid())
  transferNumber    String              @unique @map("transfer_number") // TRF-2026-000123
  sourceWarehouseId String              @map("source_warehouse_id")
  sourceWarehouse   Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destWarehouseId   String              @map("dest_warehouse_id")
  destWarehouse     Warehouse           @relation("TransferDest", fields: [destWarehouseId], references: [id])
  productId         String              @map("product_id")
  product           Product             @relation(fields: [productId], references: [id])
  packagingSizeId   String              @map("packaging_size_id")
  packagingSize     PackagingSize       @relation(fields: [packagingSizeId], references: [id])

  bagCount         Int      @map("bag_count")
  totalKg          Decimal  @map("total_kg") @db.Decimal(12, 3)
  receivedBagCount Int?     @map("received_bag_count")
  receivedKg       Decimal? @map("received_kg") @db.Decimal(12, 3)
  varianceKg       Decimal? @map("variance_kg") @db.Decimal(12, 3)

  status        StockTransferStatus @default(DISPATCHED)
  reason        String?
  requestedById String              @map("requested_by_id")
  requestedBy   User                @relation("StockTransferRequestedBy", fields: [requestedById], references: [id])
  dispatchedAt  DateTime            @default(now()) @map("dispatched_at")
  receivedById  String?             @map("received_by_id")
  receivedBy    User?               @relation("StockTransferReceivedBy", fields: [receivedById], references: [id])
  receivedAt    DateTime?           @map("received_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([sourceWarehouseId])
  @@index([destWarehouseId])
  @@map("stock_transfers")
}

enum StockTransferStatus {
  DISPATCHED
  RECEIVED
  CANCELLED
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String   @map("shipment_id")
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  eventType   String   @map("event_type") // DEPARTED, ARRIVED, RECEIVED, VARIANCE_FLAGGED
  notes       String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([shipmentId])
  @@map("shipment_events")
}

// ============================================================
// MILLING / MACHINES / PRODUCTION / QUALITY (Phase 5)
// ============================================================

model Machine {
  id                String         @id @default(uuid())
  machineCode       String         @unique @map("machine_code")
  machineName       String         @map("machine_name")
  type              String?
  manufacturer      String?
  model             String?
  serialNumber      String?        @map("serial_number")
  installationDate  DateTime?      @map("installation_date")
  millingCenterId   String         @map("milling_center_id")
  millingCenter     MillingCenter  @relation(fields: [millingCenterId], references: [id])
  ratedCapacity     Decimal?       @map("rated_capacity") @db.Decimal(10, 2)
  status            MachineStatus  @default(IDLE)
  lastMaintenanceAt DateTime?      @map("last_maintenance_at")
  nextMaintenanceAt DateTime?      @map("next_maintenance_at")
  meterType         String?        @map("meter_type")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  maintenanceLogs MachineMaintenance[]
  meterReadings   MeterReading[]
  productionRecords ProductionRecord[]

  @@index([millingCenterId])
  @@map("machines")
}

model MachineMaintenance {
  id            String          @id @default(uuid())
  machineId     String          @map("machine_id")
  machine       Machine         @relation(fields: [machineId], references: [id])
  type          MaintenanceType
  scheduledDate DateTime?       @map("scheduled_date")
  completedDate DateTime?       @map("completed_date")
  technician    String?
  cost          Decimal?        @db.Decimal(10, 2)
  downtimeHours Decimal?        @map("downtime_hours") @db.Decimal(6, 2)
  notes         String?
  createdById   String          @map("created_by_id")
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([machineId])
  @@map("machine_maintenance")
}

// Anomaly detection (spec section 20) runs at write time in the service,
// not here — this table just stores the reading plus the computed flag.
model MeterReading {
  id              String   @id @default(uuid())
  machineId       String   @map("machine_id")
  machine         Machine  @relation(fields: [machineId], references: [id])
  date            DateTime
  shift           Shift?
  openingReading  Decimal  @map("opening_reading") @db.Decimal(12, 3)
  closingReading  Decimal  @map("closing_reading") @db.Decimal(12, 3)
  consumption     Decimal  @db.Decimal(12, 3) // closingReading - openingReading, computed server-side
  unit            String   @default("kWh")
  operatorId      String   @map("operator_id")
  operator        User     @relation(fields: [operatorId], references: [id])
  isAnomalous     Boolean  @default(false) @map("is_anomalous")
  anomalyReason   String?  @map("anomaly_reason")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([machineId])
  @@index([date])
  @@map("meter_readings")
}

model ProductionRecord {
  id                    String           @id @default(uuid())
  recordNumber          String           @unique @map("record_number") // PR-2026-000123
  millingCenterId       String           @map("milling_center_id")
  millingCenter         MillingCenter    @relation(fields: [millingCenterId], references: [id])
  machineId             String?          @map("machine_id")
  machine               Machine?         @relation(fields: [machineId], references: [id])
  date                  DateTime
  shift                 Shift?
  operatorId            String           @map("operator_id")
  operator              User             @relation("ProductionOperator", fields: [operatorId], references: [id])
  paddyGradeId          String           @map("paddy_grade_id")
  paddyGrade            PaddyGrade       @relation(fields: [paddyGradeId], references: [id])

  paddyProcessedKg      Decimal          @map("paddy_processed_kg") @db.Decimal(12, 3)
  startingKg            Decimal?         @map("starting_kg") @db.Decimal(12, 3)
  endingKg               Decimal?        @map("ending_kg") @db.Decimal(12, 3)
  processingDurationMin Int?             @map("processing_duration_min")
  machineRuntimeMin     Int?             @map("machine_runtime_min")
  energyConsumptionKwh  Decimal?         @map("energy_consumption_kwh") @db.Decimal(10, 3)
  electricityMeterOpening Decimal?       @map("electricity_meter_opening") @db.Decimal(12, 3)
  electricityMeterClosing Decimal?       @map("electricity_meter_closing") @db.Decimal(12, 3)
  waterConsumption      Decimal?         @map("water_consumption") @db.Decimal(10, 3)
  fuelConsumption       Decimal?         @map("fuel_consumption") @db.Decimal(10, 3)

  recoveredRiceKg  Decimal @map("recovered_rice_kg") @db.Decimal(12, 3)
  brokenRiceKg     Decimal @map("broken_rice_kg") @db.Decimal(12, 3)
  riceHullKg       Decimal @map("rice_hull_kg") @db.Decimal(12, 3)
  wasteLossKg      Decimal @map("waste_loss_kg") @db.Decimal(12, 3)

  recoveryPercent  Decimal @map("recovery_percent") @db.Decimal(6, 3) // computed, stored for fast reporting
  brokenPercent    Decimal @map("broken_percent") @db.Decimal(6, 3)
  hullPercent      Decimal @map("hull_percent") @db.Decimal(6, 3)
  wastePercent     Decimal @map("waste_percent") @db.Decimal(6, 3)
  massBalanceFlag  Boolean @default(false) @map("mass_balance_flag") // true if unaccounted variance exceeds tolerance

  remarks         String?
  status          ProductionStatus @default(SUBMITTED)
  rejectionReason String?          @map("rejection_reason")
  submittedById   String           @map("submitted_by_id")
  submittedBy     User             @relation("ProductionSubmittedBy", fields: [submittedById], references: [id])
  approvedById    String?          @map("approved_by_id")
  approvedBy      User?            @relation("ProductionApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?        @map("approved_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([millingCenterId])
  @@index([status])
  @@index([date])
  @@map("production_records")
}

model QualityInspection {
  id                 String        @id @default(uuid())
  batchNumber        String        @map("batch_number") // PaddyBatch or PackagingBatch number — free-text link, validated at the service layer
  moisturePercent    Decimal?      @map("moisture_percent") @db.Decimal(5, 2)
  grainQuality       String?       @map("grain_quality")
  foreignMaterialPercent Decimal?  @map("foreign_material_percent") @db.Decimal(5, 2)
  brokenPercent      Decimal?      @map("broken_percent") @db.Decimal(5, 2)
  impurities         String?
  appearance         String?
  smell              String?
  qualityGrade       String?       @map("quality_grade")
  result             QualityStatus @default(PENDING)
  inspectorId        String        @map("inspector_id")
  inspector          User          @relation(fields: [inspectorId], references: [id])
  inspectionDate     DateTime      @default(now()) @map("inspection_date")
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([batchNumber])
  @@index([result])
  @@map("quality_inspections")
}

// ============================================================
// PACKAGING / WAREHOUSE FINISHED GOODS (Phase 6)
// ============================================================

model PackagingBatch {
  id              String        @id @default(uuid())
  batchNumber     String        @unique @map("batch_number") // PKG-2026-000123
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  packagingSizeId String        @map("packaging_size_id")
  packagingSize   PackagingSize @relation(fields: [packagingSizeId], references: [id])
  bagCount        Int           @map("bag_count")
  totalKg         Decimal       @map("total_kg") @db.Decimal(12, 3) // = packagingSize.sizeKg * bagCount, computed server-side, never trusted from client
  sourceBulkKg    Decimal       @map("source_bulk_kg") @db.Decimal(12, 3) // bulk unpackaged rice actually consumed
  packagingLossKg Decimal       @map("packaging_loss_kg") @db.Decimal(12, 3) // sourceBulkKg - totalKg, always >= 0
  millingCenterId String        @map("milling_center_id") // source of the bulk rice
  millingCenter   MillingCenter @relation(fields: [millingCenterId], references: [id])
  warehouseId     String        @map("warehouse_id") // destination — the milling center's own warehouse
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  packagingDate   DateTime      @map("packaging_date")
  operatorId      String        @map("operator_id")
  operator        User          @relation(fields: [operatorId], references: [id])
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([warehouseId])
  @@index([millingCenterId])
  @@map("packaging_batches")
}

// ============================================================
// SALES / CUSTOMERS / RESERVATIONS (Phase 7)
// ============================================================

model Customer {
  id              String   @id @default(uuid())
  customerNumber  String   @unique @map("customer_number") // CUST-2026-000123
  name            String
  company         String?
  phone           String?
  email           String?
  address         String?
  location        String?
  idOrBusinessRef String?  @map("id_or_business_ref") // Ghana Card / business registration, where legally appropriate
  creditLimit     Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
  paymentTerms    String?  @map("payment_terms")
  isActive        Boolean  @default(true) @map("is_active")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  salesOrders SalesOrder[]
  prices      ProductPrice[]
  invoices    Invoice[]
  payments    Payment[]

  @@map("customers")
}

// Prices can vary by product, package size, and (optionally) a specific
// customer's negotiated rate — never a single hard-coded price (spec
// section 25). Rows are never edited once created; a new effective row
// supersedes the old one, preserving price history.
model ProductPrice {
  id              String        @id @default(uuid())
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  packagingSizeId String        @map("packaging_size_id")
  packagingSize   PackagingSize @relation(fields: [packagingSizeId], references: [id])
  customerId      String?       @map("customer_id") // null = general/list price
  customer        Customer?     @relation(fields: [customerId], references: [id])
  pricePerBag     Decimal       @map("price_per_bag") @db.Decimal(12, 2)
  effectiveFrom   DateTime      @map("effective_from")
  effectiveTo     DateTime?     @map("effective_to")
  isActive        Boolean       @default(true) @map("is_active")
  createdById     String        @map("created_by_id")
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([productId, packagingSizeId, customerId])
  @@map("product_prices")
}

model SalesOrder {
  id                    String           @id @default(uuid())
  orderNumber           String           @unique @map("order_number") // SO-2026-000123
  customerId            String           @map("customer_id")
  customer              Customer         @relation(fields: [customerId], references: [id])
  salesOfficerId        String           @map("sales_officer_id")
  salesOfficer          User             @relation("SalesOfficer", fields: [salesOfficerId], references: [id])
  preferredWarehouseId  String?          @map("preferred_warehouse_id")
  preferredWarehouse    Warehouse?       @relation("PreferredWarehouse", fields: [preferredWarehouseId], references: [id])
  allocatedWarehouseId  String?          @map("allocated_warehouse_id")
  allocatedWarehouse    Warehouse?       @relation("AllocatedWarehouse", fields: [allocatedWarehouseId], references: [id])
  requestedDeliveryDate DateTime?        @map("requested_delivery_date")
  notes                 String?
  totalKg                Decimal         @default(0) @map("total_kg") @db.Decimal(12, 3)
  totalAmount             Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)

  status          SalesOrderStatus @default(DRAFT)
  rejectionReason String?          @map("rejection_reason")
  submittedById   String           @map("submitted_by_id")
  submittedBy     User             @relation("SalesOrderSubmittedBy", fields: [submittedById], references: [id])
  submittedAt     DateTime?        @map("submitted_at")
  approvedById    String?          @map("approved_by_id")
  approvedBy      User?            @relation("SalesOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?        @map("approved_at")
  fulfilledAt     DateTime?        @map("fulfilled_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  items        SalesOrderItem[]
  reservations StockReservation[]
  invoices     Invoice[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id              String        @id @default(uuid())
  salesOrderId    String        @map("sales_order_id")
  salesOrder      SalesOrder    @relation(fields: [salesOrderId], references: [id])
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  packagingSizeId String        @map("packaging_size_id")
  packagingSize   PackagingSize @relation(fields: [packagingSizeId], references: [id])
  bagCount        Int           @map("bag_count")
  totalKg         Decimal       @map("total_kg") @db.Decimal(12, 3) // = packagingSize.sizeKg * bagCount, computed server-side
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2) // per bag
  lineTotal       Decimal       @map("line_total") @db.Decimal(14, 2) // = unitPrice * bagCount, computed server-side

  reservations StockReservation[]

  @@map("sales_order_items")
}

// A hold against a warehouse balance, not a ledger movement — physical
// stock never leaves the warehouse until fulfillment. "Available to sell"
// = warehouse balance − sum(ACTIVE reservations) for that product/size,
// computed at read time, never stored as a separate mutable counter.
model StockReservation {
  id               String            @id @default(uuid())
  salesOrderId     String            @map("sales_order_id")
  salesOrder       SalesOrder        @relation(fields: [salesOrderId], references: [id])
  salesOrderItemId String            @map("sales_order_item_id")
  salesOrderItem   SalesOrderItem    @relation(fields: [salesOrderItemId], references: [id])
  warehouseId      String            @map("warehouse_id")
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  productId        String            @map("product_id")
  product          Product           @relation(fields: [productId], references: [id])
  packagingSizeId  String            @map("packaging_size_id")
  packagingSize    PackagingSize     @relation(fields: [packagingSizeId], references: [id])
  bagCount         Int               @map("bag_count")
  totalKg          Decimal           @map("total_kg") @db.Decimal(12, 3)
  status           ReservationStatus @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  releasedAt       DateTime?         @map("released_at")

  @@index([warehouseId, productId, packagingSizeId, status])
  @@map("stock_reservations")
}

// ============================================================
// FINANCE: INVOICES / PAYMENTS / EXPENSES (Phase 8)
//
// Invoice.amountPaid and .balance are NEVER stored columns — they are
// always computed from the sum of PaymentAllocation rows against that
// invoice, the same "derive from the ledger, don't trust a mutable
// counter" principle as inventory_balances. Accounts-receivable aging is
// likewise computed at query time, not maintained as a separate table.
// ============================================================

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number") // INV-2026-000123
  salesOrderId  String?       @map("sales_order_id")
  salesOrder    SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  customerId    String        @map("customer_id")
  customer      Customer      @relation(fields: [customerId], references: [id])
  subtotal      Decimal       @map("subtotal") @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  taxRate       Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2) // percent, configurable — never hard-coded Ghana tax rates (spec rule)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(14, 2) // = subtotal - discount + taxAmount, computed server-side
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  status        String        @default("OPEN") // OPEN | PARTIALLY_PAID | PAID | CANCELLED — derived at write time from allocations, not hand-set
  createdById   String        @map("created_by_id")
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")

  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id              String        @id @default(uuid())
  invoiceId       String        @map("invoice_id")
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  packagingSizeId String        @map("packaging_size_id")
  packagingSize   PackagingSize @relation(fields: [packagingSizeId], references: [id])
  bagCount        Int           @map("bag_count")
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  lineTotal       Decimal       @map("line_total") @db.Decimal(14, 2)

  @@map("invoice_items")
}

model Payment {
  id                String        @id @default(uuid())
  paymentNumber     String        @unique @map("payment_number") // PAY-2026-000123
  customerId        String        @map("customer_id")
  customer          Customer      @relation(fields: [customerId], references: [id])
  amount            Decimal       @map("amount") @db.Decimal(14, 2)
  method            PaymentMethod
  transactionReference String?    @map("transaction_reference")
  bank              String?
  paymentDate       DateTime      @map("payment_date")
  status            PaymentStatus @default(PENDING_VERIFICATION)
  recordedById      String        @map("recorded_by_id")
  recordedBy        User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  verifiedById      String?       @map("verified_by_id")
  verifiedBy        User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt        DateTime?     @map("verified_at")
  rejectionReason   String?       @map("rejection_reason")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")

  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([status])
  @@map("payments")
}

// Splits one payment across one or more invoices (or leaves it
// unallocated as customer credit) — this is what lets a single bank
// transfer settle several invoices, or a partial payment cover part of
// one (spec section 28: outstanding/aging is derived from exactly this
// table, never a separately maintained running balance).
model PaymentAllocation {
  id            String   @id @default(uuid())
  paymentId     String   @map("payment_id")
  payment       Payment  @relation(fields: [paymentId], references: [id])
  invoiceId     String   @map("invoice_id")
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amountApplied Decimal  @map("amount_applied") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model ExpenseCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  isActive Boolean   @default(true) @map("is_active")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id                String          @id @default(uuid())
  expenseNumber     String          @unique @map("expense_number") // EXP-2026-000123
  categoryId        String          @map("category_id")
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount            Decimal         @db.Decimal(14, 2)
  date              DateTime
  farmId            String?         @map("farm_id")
  farm              Farm?           @relation(fields: [farmId], references: [id])
  warehouseId       String?         @map("warehouse_id")
  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id])
  paymentMethod     PaymentMethod?  @map("payment_method")
  reference         String?
  // Only meaningful when the chosen category is the "Other" catch-all —
  // lets a Farm Manager describe what the expense actually was when
  // nothing in the fixed category list fits, without having to
  // silently misclassify it under an unrelated category just to get
  // the form to submit.
  customCategoryLabel String?       @map("custom_category_label")
  // What was physically received for the money, if anything — tools,
  // materials, supplies. Separate from `notes` on purpose: notes is
  // free-form context, this is specifically "what did we get."
  itemDescription   String?         @map("item_description")
  notes             String?
  status            ApprovalStatus  @default(PENDING)
  rejectionReason   String?         @map("rejection_reason")
  submittedById     String          @map("submitted_by_id")
  submittedBy       User            @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  approvedById      String?         @map("approved_by_id")
  approvedBy        User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?       @map("approved_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([status])
  @@index([date])
  @@map("expenses")
}

// ============================================================
// MESSAGING (Phase 9)
// ============================================================

model Conversation {
  id              String           @id @default(uuid())
  type            ConversationType
  title           String?
  requiresResponse Boolean         @default(false) @map("requires_response")
  createdById     String           @map("created_by_id")
  createdBy       User             @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now()) @map("joined_at")
  lastReadAt     DateTime?    @map("last_read_at")

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id                     String       @id @default(uuid())
  conversationId         String       @map("conversation_id")
  conversation           Conversation @relation(fields: [conversationId], references: [id])
  senderId               String       @map("sender_id")
  sender                 User         @relation(fields: [senderId], references: [id])
  body                   String
  requiresAcknowledgment Boolean      @default(false) @map("requires_acknowledgment")
  createdAt              DateTime     @default(now()) @map("created_at")

  receipts MessageReceipt[]

  @@index([conversationId])
  @@map("messages")
}

// One row per (message, recipient) — the SENT -> DELIVERED -> READ ->
// ACKNOWLEDGED -> RESPONDED progression spec section 34 requires is
// tracked per-recipient, not as a single message-level flag, since
// different recipients in a group/broadcast read and respond at
// different times.
model MessageReceipt {
  id           String               @id @default(uuid())
  messageId    String               @map("message_id")
  message      Message              @relation(fields: [messageId], references: [id])
  userId       String               @map("user_id")
  user         User                 @relation(fields: [userId], references: [id])
  status       MessageReceiptStatus @default(SENT)
  respondedAt  DateTime?            @map("responded_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([messageId, userId])
  @@index([userId, status])
  @@map("message_receipts")
}

// ============================================================
// NOTIFICATIONS (Phase 9)
// ============================================================

model Notification {
  id         String              @id @default(uuid())
  userId     String              @map("user_id")
  user       User                @relation(fields: [userId], references: [id])
  channel    NotificationChannel @default(IN_APP)
  type       String // e.g. "approval_required", "task_assigned", "message_received"
  title      String
  body       String
  entityType String?             @map("entity_type") // e.g. "PaddyEntry", "Task"
  entityId   String?             @map("entity_id")
  isRead     Boolean             @default(false) @map("is_read")
  readAt     DateTime?           @map("read_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// TASKS (Phase 9)
// ============================================================

model Task {
  id              String           @id @default(uuid())
  taskNumber      String           @unique @map("task_number") // TASK-2026-000123
  title           String
  description     String?
  assignedToId    String?          @map("assigned_to_id")
  assignedTo      User?            @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedRoleCode String?         @map("assigned_role_code") // alternative to assignedToId — any holder of this role
  farmId          String?          @map("farm_id")
  farm            Farm?            @relation(fields: [farmId], references: [id])
  warehouseId     String?          @map("warehouse_id")
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  priority        DeliveryPriority @default(NORMAL)
  dueDate         DateTime?        @map("due_date")
  status          TaskStatus       @default(TODO)
  completionEvidence String?       @map("completion_evidence")
  createdById     String           @map("created_by_id")
  createdBy       User             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  completedById   String?          @map("completed_by_id")
  completedBy     User?            @relation("TaskCompletedBy", fields: [completedById], references: [id])
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  comments TaskComment[]

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id])
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_comments")
}

// ============================================================
// AI / ANALYTICS (Phase 11)
//
// Every prediction row records exactly what produced it: which model
// version, how many historical records fed the estimate, and the
// resulting confidence — never a bare number with no traceability (spec
// section 21: "Every prediction must display confidence"). The AI layer
// only ever writes to these two tables; it has no dependency on
// InventoryLedgerService or any approval service, so it is structurally
// incapable of touching inventory or financial records directly (spec
// rule 11).
// ============================================================

model AiModel {
  id               String   @id @default(uuid())
  name             String
  version          String
  type             String // e.g. "rolling_average", "cold_start_benchmark" — see docs/AI_APPROACH.md
  trainingDataFrom DateTime?
  trainingDataTo   DateTime?
  sampleSize       Int?     @map("sample_size")
  metrics          Json?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  predictions AiPrediction[]

  @@unique([name, version])
  @@map("ai_models")
}

model AiPrediction {
  id                String   @id @default(uuid())
  modelId           String   @map("model_id")
  model             AiModel  @relation(fields: [modelId], references: [id])
  predictionType    String // e.g. "production_yield", "energy_consumption", "stock_depletion"
  inputData         Json     @map("input_data")
  predictedValue    Json     @map("predicted_value")
  confidencePercent Decimal  @map("confidence_percent") @db.Decimal(5, 2)
  expectedRangeLow  Decimal? @map("expected_range_low") @db.Decimal(14, 3)
  expectedRangeHigh Decimal? @map("expected_range_high") @db.Decimal(14, 3)
  assumptions       String?
  requestedById     String   @map("requested_by_id")
  requestedBy       User     @relation(fields: [requestedById], references: [id])
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([predictionType])
  @@index([createdAt])
  @@map("ai_predictions")
}

model AiRecommendation {
  id                String   @id @default(uuid())
  type              String // e.g. "low_recovery", "high_energy_variance"
  title             String
  body              String
  sourceEntityType  String?  @map("source_entity_type")
  sourceEntityId    String?  @map("source_entity_id")
  confidencePercent Decimal? @map("confidence_percent") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([type])
  @@map("ai_recommendations")
}

// ============================================================
// ADMIN: BACKUP RECORDS / SYSTEM RESET (Phase 12)
//
// System reset is the single most dangerous operation this spec
// describes (rule 10, section 37: "NEVER allow production data
// destruction without this approval process"). The schema below models
// the full request -> dual-approval -> execute chain the spec requires,
// but — deliberately — the *execution* logic wired up in
// system-reset.service.ts only actually performs the reset for a small,
// explicit allowlist of inventory-ledger tables. Approving other reset
// types is fully functional (the workflow itself doesn't lie about what
// state a request is in), but attempting to *execute* an out-of-scope
// reset type throws a clear "not implemented for this scope" error
// rather than silently doing something broader and riskier than what
// was actually reviewed. See docs/RESET_WORKFLOW.md.
// ============================================================

model BackupRecord {
  id            String    @id @default(uuid())
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  status        String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  sizeBytes     BigInt?   @map("size_bytes")
  location      String? // e.g. an S3/MinIO key or file path — recorded, not uploaded by this app
  triggeredById String?   @map("triggered_by_id")
  triggeredBy   User?     @relation(fields: [triggeredById], references: [id])
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([startedAt])
  @@map("backup_records")
}

model ResetRequest {
  id                 String      @id @default(uuid())
  requestNumber      String      @unique @map("request_number") // RESET-2026-000123
  resetType          ResetType   @map("reset_type")
  scope              String // human-readable description of what's affected
  affectedTables     String[]    @map("affected_tables") // model names in scope — validated against a safe allowlist at execution time
  reason             String
  impactDescription  String      @map("impact_description")
  status             ResetStatus @default(REQUESTED)

  requestedById      String      @map("requested_by_id")
  requestedBy        User        @relation("ResetRequestedBy", fields: [requestedById], references: [id])

  financeApprovedById String?    @map("finance_approved_by_id")
  financeApprovedBy   User?      @relation("ResetFinanceApprovedBy", fields: [financeApprovedById], references: [id])
  financeApprovedAt   DateTime?  @map("finance_approved_at")

  mdApprovedById     String?     @map("md_approved_by_id")
  mdApprovedBy       User?       @relation("ResetMdApprovedBy", fields: [mdApprovedById], references: [id])
  mdApprovedAt       DateTime?   @map("md_approved_at")

  rejectedById       String?     @map("rejected_by_id")
  rejectedBy         User?       @relation("ResetRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason    String?     @map("rejection_reason")

  preResetSnapshot   Json?       @map("pre_reset_snapshot") // row counts per affected table, captured immediately before execution
  executedById       String?     @map("executed_by_id")
  executedBy         User?       @relation("ResetExecutedBy", fields: [executedById], references: [id])
  executedAt         DateTime?   @map("executed_at")
  postResetVerification Json?    @map("post_reset_verification") // row counts per affected table, captured immediately after execution

  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@map("reset_requests")
}

// ============================================================
// The remaining ~4 tables (documents, approval_workflows/steps/requests/
// actions) are specified in PROJECT_PLAN.md section 3 and are noted
// there as a deliberate scope boundary (see PROJECT_PLAN.md section 6) —
// this codebase implements per-module approval workflows directly
// (paddy, delivery, production, sales, payment, expense, and now reset)
// rather than a single generic configurable engine, since retrofitting
// eight already-verified modules onto a new generic engine at this stage
// carries real regression risk for no functional gain the spec requires.
// ============================================================
